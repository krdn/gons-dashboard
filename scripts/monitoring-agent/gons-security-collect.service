[Unit]
Description=gons-dashboard security observation collector (root, oneshot)
Documentation=https://github.com/krdn/gons-dashboard/tree/main/scripts/monitoring-agent

[Service]
Type=oneshot
User=root
# ⚠️ Group 이 없으면 systemd 가 RuntimeDirectory 를 root:root 0750 으로 만들어
#    gons-agent 가 **디렉토리 탐색(x 비트)** 부터 막힌다 — 파일이 0640
#    root:gons-agent 여도 읽을 수 없다 (2026-07-20 실측: "허가 거부").
Group=gons-agent
# 수집 대상 목록 (Phase 4 §J). 에이전트의 /etc/default/gons-monitoring-agent 와
# **별개 파일**이다 — 그 파일에는 METRICS_INGEST_TOKEN 이 들어있어 root collector
# 에 읽힐 이유가 없다(최소권한). 이 파일에는 컨테이너 이름만 있어 시크릿이 없다.
# ⚠️ `-` 접두: 파일이 없어도 유닛은 뜬다. 그때 DATASTORE_CONTAINERS 가 비어
# datastoreStats:[] 가 되고 서버가 not-reported unknown 으로 드러낸다(조용한 실패 아님).
EnvironmentFile=-/etc/default/gons-security-collect
ExecStart=/opt/gons/monitoring-agent/gons-security-collect.sh

# --- 샌드박스 (운영 서버 systemd-run 실증 기반) ---
#
# ⚠️ PrivateNetwork=yes 를 쓰면 안 된다. 네트워크 네임스페이스는 인터페이스뿐 아니라
#    netfilter 규칙 테이블 전체를 격리해서, 격리된 네임스페이스에는 DOCKER-USER 가
#    없다 → "규칙 0개 = 방어선 붕괴" 로 오판한다.
#    실측: PrivateNetwork=yes → `iptables -S DOCKER-USER` 1줄(오류) / 미격리 → 6줄.
#    외부 통신 차단 목적은 IPAddressDeny 로 달성한다 (호스트 netns 는 보존, 실측 6줄).
IPAddressDeny=any

ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes

# `ufw status` 는 조회만 해도 /run/ufw.lock 을 생성한다 — ProtectSystem=strict 아래서는
# 락 생성이 실패해 ufw 가 traceback 으로 죽고, 관측이 영구 unknown 이 된다(2026-07-20 실측).
#
# ⚠️ ReadWritePaths=/run/ufw.lock 처럼 **파일 자체**를 지정하면 안 된다 — systemd 는 그
#    경로를 bind-mount 하므로 파일이 없으면 유닛이 시작조차 못 한다. 재부팅 직후처럼
#    락이 아직 없는 상태에서 collector 전체가 죽는다 (실측: 락 삭제 후 무출력·rc0 이지만
#    ufw 미실행). 부모 디렉토리를 열어야 "없으면 생성" 경로가 성립한다.
#    (락 있음/없음 두 상태 모두 /run 으로 실증 완료.)
ReadWritePaths=/run

# ⚠️ RuntimeDirectory 단독이면 서비스 중지 시 디렉토리가 삭제된다. Type=oneshot 은
#    종료가 곧 중지라 **파일을 쓰자마자 사라진다**. 실측으로 확인 — Preserve 필수.
#    (RemainAfterExit=yes 는 타이머 후속 실행을 막을 수 있어 해결책으로 쓰지 않는다.)
RuntimeDirectory=gons-monitoring
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0750
