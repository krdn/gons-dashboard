[Unit]
Description=gons-dashboard monitoring agent (host vitals push)
Documentation=https://github.com/krdn/gons-dashboard/tree/main/scripts/monitoring-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# METRICS_INGEST_TOKEN / DASHBOARD_URL / HOST_NAME / INTERVAL_SEC
EnvironmentFile=/etc/default/gons-monitoring-agent
ExecStart=/opt/gons/monitoring-agent/agent.sh
Restart=always
RestartSec=10
# 수집 대상이 /proc·hwmon·nvidia-smi 뿐이라 비권한 실행 (DynamicUser —
# PrivateTmp 포함). Phase 2~3 에서 journalctl·iptables 수집이 추가되면
# 그때 전용 사용자 + 최소 권한(capabilities/그룹)으로 재설계한다.
DynamicUser=yes

[Install]
WantedBy=multi-user.target
