[Unit]
Description=gons-dashboard monitoring agent (host vitals push)
Documentation=https://github.com/krdn/gons-dashboard/tree/main/scripts/monitoring-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# METRICS_INGEST_TOKEN / DASHBOARD_URL / HOST_NAME / INTERVAL_SEC / WATCH_* / HOSTCRON_SPECS
EnvironmentFile=/etc/default/gons-monitoring-agent
ExecStart=/opt/gons/monitoring-agent/agent.sh
Restart=always
RestartSec=10
# 2026-07-24 사고: 외부 명령(nvidia-smi)이 반환하지 않아 수집 루프가 멈췄는데 systemd 는
# 2일간 active(running) 로 보고했다 — 관측 시스템 자신의 미탐. agent.sh 가 매 사이클
# WATCHDOG=1 을 보내고, 90초(수집 주기 15초의 6배) 동안 없으면 systemd 가 재시작한다.
# Type=simple 을 유지하므로 READY=1 은 불필요하다(Type=notify 로 바꾸면 READY 를 못 보낼 때
# 서비스가 아예 시작 실패한다). NotifyAccess=all — systemd-notify 는 별도 자식 프로세스다.
# agent.sh 는 heartbeat 간격을 systemd 가 주는 WATCHDOG_USEC 에서 유도한다(1/3). 따라서
# 이 값을 바꾸거나 INTERVAL_SEC 을 늘려도 양쪽이 자동으로 맞는다 — 고정 간격이었다면
# INTERVAL_SEC 을 WatchdogSec 보다 크게 잡는 순간 정상 에이전트가 재시작 루프에 빠진다.
WatchdogSec=90
NotifyAccess=all
# Phase 2: systemctl 조회(checks)가 필요한데 DynamicUser 의 임시 UID 는 D-Bus
# 시스템 버스 연결이 거부된다("Transport endpoint is not connected") — 고정
# 시스템 유저로 전환하고 DynamicUser 가 주던 격리는 명시 옵션으로 유지.
# 설치 시 유저 생성 필요: sudo useradd --system --no-create-home --shell /usr/sbin/nologin gons-agent
User=gons-agent
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=full
# 호스트 cron 로그(/home/gon/...) 읽기는 필요 — read-only 로 제한
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
